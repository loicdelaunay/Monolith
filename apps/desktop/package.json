{
  "name": "@monolith/desktop",
  "version": "3.0.0-alpha.22",
  "private": true,
  "type": "module",
  "description": "Monolith Harness — interface desktop (Electron + Vue 3 + PrimeVue 4)",
  "author": "Loïc DELAUNAY",
  "license": "MIT",
  "homepage": "https://github.com/loicdelaunay/Monolith",
  "repository": {
    "type": "git",
    "url": "https://github.com/loicdelaunay/Monolith.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml"
  },
  "devDependencies": {
    "@monolith/contracts": "3.0.0-alpha.22",
    "@monolith/core": "3.0.0-alpha.22",
    "@primeuix/themes": "2.0.3",
    "@types/markdown-it": "14.2.0",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "katex": "^0.19.0",
    "markdown-it": "15.0.3",
    "mermaid": "^12.2.0",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "shiki": "4.5.0",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-tsc": "3.3.13"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.95.1"
  }
